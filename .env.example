# Cliente: usa "local" para desarrollo sin red o "remote" para la API.
LUMO_RUNTIME_MODE=local
LUMO_DATA_DIR=.lumo-data

# El cliente sólo compila el origen público. Las credenciales revocables se
# crean durante el emparejamiento y nunca forman parte del APK.
LUMO_API_URL=https://api.example.invalid

# Servicio lumo-api. Estos dos nombres son identidad persistente del VPS; no
# deben cambiar al mover o renombrar el checkout.
COMPOSE_PROJECT_NAME=lumo
LUMO_DATA_VOLUME=lumo_lumo-data
LUMO_API_BIND=0.0.0.0:8443
LUMO_API_DATABASE=/data/lumo-api.sqlite3
LUMO_SERVER_MASTER_KEY=replace-with-a-long-random-server-secret
LUMO_ENABLE_LEGACY_V1=false
LUMO_TRUST_PROXY_HEADERS=false
LUMO_MAX_GROUPS=1000
LUMO_MAX_DEVICES_PER_GROUP=8
LUMO_MAX_ACTIVE_INVITES_PER_GROUP=8
LUMO_BOOTSTRAP_PER_IP=5
LUMO_BOOTSTRAP_GLOBAL=100
LUMO_BOOTSTRAP_WINDOW_SECONDS=3600
LUMO_INVITE_TTL_SECONDS=600
LUMO_TLS_CERT_PATH=/certs/fullchain.pem
LUMO_TLS_KEY_PATH=/certs/privkey.pem
LUMO_API_HOST=127.0.0.1
LUMO_API_PORT=8443

# Gate obligatorio de scripts/deploy.sh; no se inyecta en el contenedor.
LUMO_PUBLIC_URL=https://api.example.invalid

# Opcional: despliegue detrás de un proxy Docker compartido.
LUMO_PROXY_NETWORK=reverse-proxy
