# Cliente: usa "local" para desarrollo sin red o "remote" para la API.
LUMO_RUNTIME_MODE=local
LUMO_DATA_DIR=.lumo-data

# Cliente y servidor comparten este secreto. Usa 32 bytes aleatorios como mínimo.
# Nunca lo declares como VITE_*: Vite expondría el valor al JavaScript del APK.
# El build deriva automáticamente el origen público del QR desde LUMO_API_URL.
LUMO_API_URL=https://api.example.invalid:8443
LUMO_API_PASSWORD=replace-with-a-long-random-secret

# Servicio lumo-api.
LUMO_API_BIND=0.0.0.0:8443
LUMO_API_DATABASE=/data/lumo-api.sqlite3
LUMO_TLS_CERT_PATH=/certs/fullchain.pem
LUMO_TLS_KEY_PATH=/certs/privkey.pem
LUMO_API_PORT=8443

# Opcional: despliegue detrás de un proxy Docker compartido.
LUMO_PROXY_NETWORK=reverse-proxy
