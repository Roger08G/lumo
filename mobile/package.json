{
    "name": "lumo-mobile",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "test": "bun test src scripts",
        "audit": "bun audit",
        "preview": "vite preview",
        "tauri": "node scripts/tauri-env.mjs",
        "fmt": "prettier --write --config .prettierrc --ignore-path .prettierignore .prettierrc \"**/*.{json,md,mjs,js,ts,tsx,jsx}\"",
        "fmt:check": "prettier --check --config .prettierrc --ignore-path .prettierignore .prettierrc \"**/*.{json,md,mjs,js,ts,tsx,jsx}\""
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-barcode-scanner": "^2.4.6",
        "@tauri-apps/plugin-geolocation": "2.3.3",
        "gsap": "^3.15.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-icons": "^5.7.0",
        "sonner": "^2.0.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tauri-apps/cli": "^2",
        "@types/react": "^19.1.8",
        "@types/react-dom": "19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^16.5.0",
        "prettier": "^3.8.3",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.2.2"
    }
}
